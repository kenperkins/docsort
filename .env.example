# Classifier: Claude by default...
ANTHROPIC_API_KEY=sk-ant-...
# ...or a model you host, behind any OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp...).
# CLASSIFIER=openai-compatible
# CLASSIFIER_BASE_URL=http://ollama:11434/v1
# CLASSIFIER_MODEL=qwen2.5vl:7b

# The URL people use to reach docsort (through your reverse proxy).
APP_URL=https://docsort.example.com

# Log in through any OpenID Connect provider (Authelia, Authentik, Keycloak, Google...).
# Register a confidential client with redirect URI ${APP_URL}/auth/callback and scopes
# "openid profile email groups".
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=docsort
OIDC_CLIENT_SECRET=change-me
# Members of this group get full access (default: admins).
# AUTH_ADMIN_GROUP=admins
# Optional read-only group.
# AUTH_READER_GROUP=family

# Or, behind an authenticating proxy that sets Remote-User / Remote-Groups:
# AUTH_MODE=proxy
# TRUSTED_PROXIES=172.16.0.0/12

# PEOPLE_FILE=/config/people.json
# TAGS_FILE=/config/tags.json
# CLAUDE_MODEL=claude-sonnet-5-5
